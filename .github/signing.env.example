# Copy this to .github/signing.env, fill it in, and the release recipes will read
# it. That file is git-ignored and never leaves this machine; exporting the three
# variables yourself instead works just as well.
#
# The keystore itself lives at android/app/upload-keystore.jks and is made once:
#
#   keytool -genkeypair -v -keystore android/app/upload-keystore.jks \
#     -storetype PKCS12 -keyalg RSA -keysize 4096 -validity 10000 -alias dioretsa
#
# PKCS12 keeps one password for the store and the key, so both variables below
# hold the same value. They stay separate because that is the shape Gradle asks
# for, and the shape the launcher's release cycle already uses.

export SIGNING_KEYSTORE_PASSWORD=""
export SIGNING_KEY_PASSWORD=""
export SIGNING_KEY_ALIAS="dioretsa"
