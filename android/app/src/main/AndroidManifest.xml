<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A television has no touchscreen and no telephone hardware. Saying so
         keeps the app from being filtered out as a phone app that happens to
         be missing things. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Two shapes of the same picture. The banner is the 16:9 tile the
         television's own launcher shows; the icon is the square Android asks
         for everywhere else, and is the same wordmark with more sky over and
         under it rather than a crop. -->
    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@mipmap/icon"
        android:isGame="true">

        <!-- The game itself is the shared library named below: NativeActivity
             loads it, raylib's android_main() runs inside it, and that calls the
             main() in src/main.c. The subclass adds one thing that can only be
             asked for from Java, and is otherwise NativeActivity. -->
        <activity
            android:name=".DioretsaActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize">

            <meta-data android:name="android.app.lib_name" android:value="dioretsa" />

            <!-- LEANBACK_LAUNCHER, and only that: this belongs on a television
                 and has no business showing up in a phone's app drawer. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
